# `use nvm <version>` in .envrc — served by mise, falls back to nvm
use_nvm() {
  local node_version=$1

  if has mise; then
    mise install -q "node@$node_version" && PATH_add "$(mise where "node@$node_version")/bin"
    return
  fi

  nvm_sh=~/.nvm/nvm.sh
  if [[ -e $nvm_sh ]]; then
    source $nvm_sh
    nvm use $node_version
  fi
}

# Auto-activate .venv if it exists
layout_uv() {
    if [[ -d .venv ]]; then
        source_env .venv/bin/activate
    fi
}

# `layout gomod` in .envrc — keep Go's module cache inside the project
layout_gomod() {
  export GOMODCACHE="$PWD/pkg/mod"
}

# `use claude_profile <name>` in .envrc — claude/c in this tree run as that
# Claude Code profile (see .claude-profile.sh). CLAUDE_CONFIG_DIR is exported
# too, so `command claude` and editors launched from here follow it.
use_claude_profile() {
  export CLAUDE_PROFILE=$1
  if [[ $1 == default ]]; then
    unset CLAUDE_CONFIG_DIR
  else
    export CLAUDE_CONFIG_DIR="${CLAUDE_PROFILE_ROOT:-$HOME/.claude-profiles}/$1"
    dotenv_if_exists "$CLAUDE_CONFIG_DIR/profile.env"
  fi
}
