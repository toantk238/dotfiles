#!/bin/sh
# Polyglot header: sh re-executes this file with the git/ project venv via uv,
# so the CLI works from any cwd. Python sees the next line as a string literal.
''''exec uv run --quiet --project "$(dirname "$(readlink -f "$0")")" python "$0" "$@" # '''

"""gittool: keep a main repo and its submodules on the same branch, verify
before pushing, and merge with submodule-pointer conflict resolution."""

import argparse
import sys
from pathlib import Path

from pygit2 import GitError

from helper import BigRepo, NotARepository, logger


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="gittool",
        description="Help devs work easily with submodules",
        epilog="toantk238@gmail.com")
    sub = parser.add_subparsers(dest="action", required=True, metavar="action")

    def command(name: str, help_text: str) -> argparse.ArgumentParser:
        p = sub.add_parser(name, help=help_text, description=help_text)
        p.add_argument("path", nargs="?", default=".", help="main repo (default: cwd)")
        return p

    def ai_options(p: argparse.ArgumentParser) -> None:
        group = p.add_mutually_exclusive_group()
        group.add_argument("--ai", metavar="TOOL",
                           help="resolve leftover conflicts with this AI tool (claude, agy, or one "
                                "from GITTOOL_AI_TOOLS); default: ask when interactive")
        group.add_argument("--no-ai", action="store_true", help="never offer an AI tool")

    command("sync", "init submodules and put detached ones on the main repo's branch")
    command("verify_before_push", "fail unless every repo is clean and submodule commits are pushed")
    merge = command("merge", "merge a branch; conflicting submodules keep ours, then get their "
                             "matching branch merged in; file conflicts can go to an AI tool")
    merge.add_argument("-b", "--branch", required=True, help="local or remote branch, e.g. origin/dev")
    ai_options(merge)
    resolve = command("resolve_conflicts", "resume a merge: commit resolved conflicts, then run the "
                                           "deferred submodule merges")
    ai_options(resolve)
    prs = command("create_prs", "open a GitHub PR (via gh) for every submodule whose branch is not "
                                "merged into its default branch yet")
    prs.add_argument("--base", help="target branch for every repo (default: each repo's origin/HEAD, "
                                    "else its .gitmodules branch, else main/master)")
    prs.add_argument("--push", action="store_true", help="push branches that are ahead of origin first")
    prs.add_argument("--title", help="PR title for every repo (default: the commit subject when the "
                                     "branch has one commit, else the branch name); body is left empty")
    prs.add_argument("--repos-json", type=Path, help="maps <KEY>_BRANCH template lines to submodules "
                                                     "(default: buildPlugin/root/repos.json if present)")
    prs.add_argument("--no-edit", action="store_true", help="leave the body of already open PRs alone "
                                                           "(default: fix their <KEY>_BRANCH lines)")
    prs.add_argument("--draft", action="store_true", help="open the PRs as drafts")
    prs.add_argument("-n", "--dry-run", action="store_true", help="only report what would be opened")
    prs.add_argument("--include-main", action="store_true", help="also handle the main repo itself")
    default = command("checkout_default", "put every submodule on its default branch (repos.json "
                                          "default_branch), only if that branch has its current code")
    default.add_argument("--repos-json", type=Path, help="default branches per submodule path "
                                                         "(default: buildPlugin/root/repos.json if present)")
    default.add_argument("--no-fetch", action="store_true", help="use the remote branches as last fetched")
    default.add_argument("-n", "--dry-run", action="store_true", help="only report what would be checked out")
    remove = command("remove_submodules", "deinit and delete every submodule (destructive)")
    remove.add_argument("-y", "--yes", action="store_true", help="skip the confirmation prompt")
    completion = sub.add_parser("completion", help="print a shell completion script",
                                description='print a shell completion script; add '
                                            '`eval "$(gittool completion zsh)"` to .zshrc after compinit')
    completion.add_argument("shell", choices=["zsh"])
    return parser


def ai_mode(args: argparse.Namespace) -> str | None:
    if getattr(args, "no_ai", False):
        return None
    if getattr(args, "ai", None):
        return args.ai
    return "ask" if sys.stdin.isatty() else None


def confirm_removal(repo_path: Path) -> bool:
    if not sys.stdin.isatty():
        logger.error("remove_submodules deletes submodule checkouts; pass --yes to confirm")
        return False
    answer = input(f"Remove ALL submodules of {repo_path}? This deletes their checkouts. [y/N]: ")
    return answer.strip().lower() in ("y", "yes")


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    logger.debug("args=%s", vars(args))
    if args.action == "completion":
        from helper.completion import zsh_script
        sys.stdout.write(zsh_script(parser))
        return 0
    path = Path(args.path).resolve()

    try:
        big_repo = BigRepo(path, ai=ai_mode(args))
        if args.action == "sync":
            ok = big_repo.sync_branch()
        elif args.action == "verify_before_push":
            ok = big_repo.verify_before_push()
        elif args.action == "merge":
            ok = big_repo.merge(args.branch)
        elif args.action == "resolve_conflicts":
            ok = big_repo.resolve_conflicts()
        elif args.action == "create_prs":
            ok = big_repo.create_prs(base=args.base, push=args.push, draft=args.draft,
                                     dry_run=args.dry_run, include_main=args.include_main,
                                     title=args.title, repos_json=args.repos_json,
                                     edit=not args.no_edit)
        elif args.action == "checkout_default":
            ok = big_repo.checkout_default(repos_json=args.repos_json, fetch=not args.no_fetch,
                                           dry_run=args.dry_run)
        elif args.action == "remove_submodules":
            if not args.yes and not confirm_removal(path):
                return 1
            big_repo.remove_submodules()
            ok = True
        else:  # unreachable: argparse rejects unknown actions
            raise AssertionError(args.action)
    except NotARepository as exc:
        logger.error("%s", exc)
        return 1
    except (ValueError, RuntimeError, GitError) as exc:
        logger.error("%s", exc)
        return 1
    except KeyboardInterrupt:
        return 130
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
