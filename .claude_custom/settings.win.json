{
  "includeCoAuthoredBy": true,
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "TodoWrite",
      "WebFetch",
      "NotebookEdit",
      "Bash",
      "WebSearch",
      "mcp__plugin_context-mode_context-mode__*",
      "mcp__code-review-graph__*",
      "mcp__sequential-thinking__*",
      "mcp__memory__*",
      "mcp__plugin_figma_figma__*",
      "Skill(superpowers:*)",
      "Agent",
      "mcp__codegraph__*"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(sudo rm -rf :*)",
      "Bash(dd if=/dev/zero of=*)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "additionalDirectories": []
  },
  "model": "opus[1m]",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "sequential-thinking",
    "memory"
  ],
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "context-mode@context-mode": true,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "codeceptjs-skills": {
      "source": {
        "source": "github",
        "repo": "codeceptjs/skills"
      }
    }
  },
  "forceLoginMethod": "claudeai",
  "outputStyle": "default",
  "askUserQuestionTimeout": "60s",
  "autoUpdatesChannel": "latest",
  "minimumVersion": "2.1.241",
  "tui": "default",
  "editorMode": "normal",
  "verbose": false,
  "autoCompactEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if (Test-Path ~/.env.ps1) { . ~/.env.ps1 }; if (Test-Path ~/.claude/notify_slack.ps1) { . ~/.claude/notify_slack.ps1 }",
            "shell": "powershell"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "if (Test-Path ~/.env.ps1) { . ~/.env.ps1 }; $input | & ~/.claude/hooks/.venv/Scripts/python.exe ~/.claude/hooks/ask_user_question_handler.py; exit $LASTEXITCODE",
            "shell": "powershell",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "^(?!AskUserQuestion$)",
        "hooks": [
          {
            "type": "command",
            "command": "if (Test-Path ~/.env.ps1) { . ~/.env.ps1 }; $input | & ~/.claude/hooks/.venv/Scripts/python.exe ~/.claude/hooks/pre_tool_reviewer.py; exit $LASTEXITCODE",
            "shell": "powershell"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if (Test-Path ~/.env.ps1) { . ~/.env.ps1 }; $input | & ~/.claude/hooks/.venv/Scripts/python.exe ~/.claude/hooks/stop_router.py; exit $LASTEXITCODE",
            "shell": "powershell",
            "timeout": 120,
            "statusMessage": "AI reviewing..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph status",
            "shell": "powershell",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/context-mode-cache-heal.mjs",
            "shell": "powershell"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph update --skip-flows",
            "shell": "powershell",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook",
            "shell": "powershell"
          }
        ]
      }
    ]
  }
}
