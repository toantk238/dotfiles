# ssh takes the first value it finds, so per-host settings stay above the
# shared block at the bottom.

# Work GitHub account
Host github.com
  IdentityFile ~/.ssh/rock_rsa

# Personal GitHub account
Host github.com-toantk238
  HostName github.com
  IdentityFile ~/.ssh/toantk238_rsa

# Personal GitHub account
Host github.com-herrietako
  HostName github.com
  IdentityFile ~/.ssh/herrietako_ed25519

Host git.deepaffex.ai
  IdentityFile ~/.ssh/rock_rsa

# Personal Gitlab
Host gitlab.com
  IdentityFile ~/.ssh/toantk238_rsa

# Bitbucket
Host bitbucket.org
  IdentityFile ~/.ssh/rock_rsa

# Shared settings for all git hosts
Host github.com github.com-* git.deepaffex.ai gitlab.com bitbucket.org
  User git
  AddKeysToAgent yes
  IdentitiesOnly yes
  ControlMaster auto
  # Keep %n: it is the alias as typed. %h and %C resolve to HostName, so the
  # github.com-* aliases would share one socket and authenticate as the wrong
  # account.
  ControlPath ~/.ssh/cm-%r@%n:%p
  ControlPersist 10m
  # Detect a dead master after sleep or a network change, instead of hanging
  # every git command that is multiplexed over it.
  ServerAliveInterval 30
  ServerAliveCountMax 3
  ConnectTimeout 10
